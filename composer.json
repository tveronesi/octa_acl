{
    "name": "gunz/octa-acl",
    "description": "Lightweight, framework-agnostic bitmask ACL library for PHP",
    "type": "library",
    "license": "MIT",
    "keywords": ["acl", "access-control", "bitmask", "permissions", "authorization"],
    "authors": [
        {
            "name": "Tiago Veronesi",
            "email": "tveronesi@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Gunz\\OctaAcl\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gunz\\OctaAcl\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test:coverage": "vendor/bin/phpunit --coverage-text"
    },
    "config": {
        "sort-packages": true
    }
}
